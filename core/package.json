{
  "name": "@design-system/core",
  "version": "0.1.0-alpha.0",
  "description": "Framework-agnostic state, behavior and accessibility logic for the design system.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dr2madre/invisible-ui.git",
    "directory": "core"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup && node scripts/patch-esm-specifiers.mjs",
    "smoke": "node scripts/smoke-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
